# Copy this file to .env.staging on the VPS and replace every placeholder.
# Do not commit .env.staging.

POSTGRES_DB=negotiation_tools
POSTGRES_USER=negotiation
POSTGRES_PASSWORD=replace-with-a-long-random-password

DATABASE_URL=postgresql+psycopg://negotiation:replace-with-a-long-random-password@db:5432/negotiation_tools

# Public staging origin that users open in the browser, for example:
# https://staging.example.com
STAGING_PUBLIC_ORIGIN=https://replace-with-staging-domain.example

# Browser-facing API base URL. With a same-domain reverse proxy, route /api to backend.
NEXT_PUBLIC_API_URL=https://replace-with-staging-domain.example

# Server-side calls from the Next.js container to the FastAPI container.
SERVER_API_URL=http://backend:8000

# Comma-separated browser origins allowed by FastAPI CORS.
BACKEND_CORS_ORIGINS=https://replace-with-staging-domain.example

# Bind app containers to localhost on the VPS; the reverse proxy exposes HTTPS.
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000

UPLOAD_BASE_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=25
